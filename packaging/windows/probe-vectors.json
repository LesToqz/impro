      "expect": { "WS_CAPTION": false, "WS_THICKFRAME": false, "WS_SYSMENU": false, "WS_MINIMIZEBOX": false, "WS_MAXIMIZEBOX": false, "WS_VISIBLE": true } },
    { "style": -1879048192, "note": "the same bits as the signed value GetWindowLong returns",
