    { "value": 0, "expect": "#000000" },
    { "value": 16777215, "expect": "#FFFFFF" },
    { "value": 3351057, "expect": "#112233" },
    { "value": 12624000, "expect": "#80A0C0" },
    { "value": 2105376, "expect": "#202020" },
    { "value": 16777216, "expect": "0x01000000" },
    { "value": 4294967294, "expect": "0xFFFFFFFE" },
    { "value": 4294967295, "expect": "0xFFFFFFFF" },
    { "value": -1, "expect": "0xFFFFFFFF" }
  ],
  "hex32": [
    { "value": 0, "expect": "0x00000000" },
    { "value": 255, "expect": "0x000000FF" },
    { "value": 4294967295, "expect": "0xFFFFFFFF" },
    { "value": -1, "expect": "0xFFFFFFFF" },
    { "value": 2147942487, "expect": "0x80070057" },
    { "value": -2147024809, "expect": "0x80070057" }
