      "expect": { "WS_CAPTION": true, "WS_THICKFRAME": false, "WS_SYSMENU": false, "WS_MINIMIZEBOX": false, "WS_MAXIMIZEBOX": false, "WS_VISIBLE": false } },
    { "style": 281673728, "note": "0x10CA0000: caption, system menu, minimize box, visible; fixed size",
      "expect": { "WS_CAPTION": true, "WS_THICKFRAME": false, "WS_SYSMENU": true, "WS_MINIMIZEBOX": true, "WS_MAXIMIZEBOX": false, "WS_VISIBLE": true } }
