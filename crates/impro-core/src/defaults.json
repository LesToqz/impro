{
  "theme": "impro-dark",
  "terminal_font_size": 11,
  "editor_font_size": 11,
  "explorer_font_size": 10,
  "feature_explorer": true,
  "feature_terminal": true,
  "feature_graph": true,
  "feature_gitgraph": true,
  "feature_notes": true,
  "explorer_git_colors": true,
  "explorer_folders_first": true,
  "explorer_compact": false,
  "terminal_max_panes": 6,
  "terminal_shell": "",
  "terminal_copy_on_select": false,
  "terminal_bell": false,
  "graph_default_type": "global",
  "gitgraph_orientation": "horizontal",
  "gitgraph_max_commits": 1500,
  "gitgraph_show_remotes": true,
  "gitgraph_show_tags": true,
  "gitgraph_time_format": "relative",
  "notes_slash_commands": true,
  "notes_toolbar": true,
  "notes_selection_toolbar": true,
  "notes_sort": "name",
  "notes_open_after_create": true,
  "accent": null,
  "reduce_motion": false,
  "ui_font": "",
  "editor_font": "",
  "line_numbers": true,
  "highlight_line": true,
  "md_live_preview": true,
  "md_readable_width": true,
  "indent_tabs": false,
  "indent_width": 4,
  "auto_pair": true,
  "show_hidden": true,
  "confirm_delete": true,
  "delete_mode": "permanent",
  "terminal_cursor": "block",
  "terminal_blink": true,
  "terminal_scrollback": 10000,
  "terminal_autostart": true
}
